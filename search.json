---
layout: null
---
[{%- assign P = site.posts | where: "lang", page.lang -%}{% for p in P %}{"t":{{ p.title | jsonify }},"u":"{{ p.url | relative_url }}","d":"{{ p.date | date: '%Y.%m.%d' }}","c":{{ p.category | jsonify }},"g":{{ p.tags | jsonify }},"s":{{ p.summary | default: p.excerpt | strip_html | strip_newlines | jsonify }},"x":{{ p.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
